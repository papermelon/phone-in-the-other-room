{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counting-sheep-screenbook-scenario-manifest-v1",
  "title": "Counting Sheep Screenbook scenario manifest",
  "type": "object",
  "required": ["schemaVersion", "captureProfile", "manifestHash", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "captureProfile": { "const": "iphone17-ios26.5-enSG-standard" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "title", "surface", "journey", "route", "state", "fixtureVersion", "captureProfile", "captureProvenance", "dependencies", "copy", "warnings", "screenshot", "fingerprint", "copyHash", "changeStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^iphone\\.[a-z0-9.-]+\\.default$" },
          "fixtureVersion": { "type": "integer", "minimum": 1 },
          "captureProvenance": { "const": "automated-simulator" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "copy": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "rendered", "authored", "kind", "source", "status", "parameters"],
              "properties": {
                "status": { "enum": ["stable", "provisional"] },
                "source": {
                  "type": "object",
                  "required": ["file", "symbol"],
                  "properties": { "file": { "type": "string" }, "symbol": { "type": "string" } }
                }
              }
            }
          },
          "screenshot": {
            "type": "object",
            "required": ["path", "width", "height", "sha256", "pixelHash"],
            "properties": {
              "width": { "type": "integer", "minimum": 1000 },
              "height": { "type": "integer", "minimum": 2000 }
            }
          }
        }
      }
    }
  }
}
