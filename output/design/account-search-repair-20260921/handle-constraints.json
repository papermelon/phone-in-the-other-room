  {
    "conname": "account_usernames_normalized",
    "definition": "CHECK ((username ~ '^[a-z][a-z0-9_]{2,23}$'::text))"
  },
  {
    "conname": "account_usernames_pkey",
    "definition": "PRIMARY KEY (user_id)"
  },
  {
    "conname": "account_usernames_user_id_fkey",
